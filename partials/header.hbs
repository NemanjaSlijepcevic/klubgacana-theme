<header id="gh-head" class="gh-head gh-outer">
    <div class="gh-head-inner gh-inner">
        <div class="gh-head-brand">
            <div class="gh-head-brand-wrapper">
                <img class="kg-crest" src="{{asset "images/grb-gacko.png"}}" width="27" height="37" alt="Грб Гацка">
                <p>&ensp;</p>
                {{#is "home"}}<h1 class="gh-head-logo">{{/is}}
                <a {{^is "home"}}class="gh-head-logo"{{/is}} href="{{@site.url}}">
                    {{#if @site.logo}}
                        <img src="{{@site.logo}}" alt="{{@site.title}}">
                        {{#if @custom.white_publication_logo_for_transparent_header}}
                            <img src="{{@custom.white_publication_logo_for_transparent_header}}" alt="{{@site.title}}">
                        {{/if}}
                    {{else}}
                        {{@site.title}}
                    {{/if}}
                </a>
                {{#is "home"}}</h1>{{/is}}
            </div>
            <button class="gh-search gh-icon-btn" aria-label="Претражи сајт" data-ghost-search>{{> "icons/search"}}</button>
            <button class="gh-burger"></button>
        </div>

        <nav class="gh-head-menu">
            <ul class="custom-menu">
                <li><a href="/">Почетна</a></li>
                <li class="has-dropdown">
                    <a href="#">О нама</a>
                    <ul class="dropdown">
                        <li><a href="/onama//">О клубу</a></li>
                        <li><a href="/clanstvo/">Чланство</a></li>
                        <li><a href="/kontakt/">Контакт</a></li>
                    </ul>
                </li>
                <li class="has-dropdown">
                    <a href="#">Наслеђе</a>
                    <ul class="dropdown">
                        <li><a href="/tag/gacani/">Гачани</a></li>
                        <li><a href="/bibliografija/">Библиографија</a></li>
                        <li><a href="/kaleidoskop/">Калеидоскоп</a></li>
                    </ul>
                </li>
                <li><a href="/tag/dogadjaji/">Догађаји</a></li>
                <li><a href="/tag/humanizam/">Хуманизам</a></li>
            </ul>
            {{#unless @site.members_enabled}}
                {{#match @custom.navigation_layout "Stacked"}}
                    <button class="gh-search gh-icon-btn" aria-label="Претражи сајт" data-ghost-search>{{> "icons/search"}}</button>
                {{/match}}
            {{/unless}}
        </nav>

        <div class="gh-head-actions">
            {{> "prefs-toggles"}}

            {{#unless @site.members_enabled}}
                {{^match @custom.navigation_layout "Stacked"}}
                    <button class="gh-search gh-icon-btn" aria-label="Претражи сајт" data-ghost-search>{{> "icons/search"}}</button>
                {{/match}}
            {{else}}
                <button class="gh-search gh-icon-btn" aria-label="Претражи сајт" data-ghost-search>{{> "icons/search"}}</button>
                <div class="gh-head-members">
                    {{#unless @member}}
                        {{#unless @site.members_invite_only}}
                            <a class="gh-head-link" href="#/portal/signin" data-portal="signin">Улаз</a>
                            <a class="gh-head-btn gh-btn gh-primary-btn" href="#/portal/signup" data-portal="signup">Пријава</a>
                        {{else}}
                            <a class="gh-head-btn gh-btn gh-primary-btn" href="#/portal/signin" data-portal="signin">Улаз</a>
                        {{/unless}}
                    {{else}}
                        <a class="gh-head-btn gh-btn gh-primary-btn" href="#/portal/account" data-portal="account">Налог</a>
                    {{/unless}}
                </div>
            {{/unless}}
        </div>
    </div>
</header>
